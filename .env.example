# Copy this file to .env and fill in your own values.
# NEVER put real passwords or keys in this example file.

# Required. Make one with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
FLASK_DEBUG=true

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lumora_db
DB_USER=
DB_PASSWORD=

# Login mode: demo (local accounts) or google (needs Google setup)
AUTH_MODE=demo

# Optional. Days a 'Remember me' login lasts
REMEMBER_ME_DAYS=7

# Optional. Password for the fictional demo accounts (default is in config.py)
DEMO_PASSWORD=

# AI: leave empty to use the demo (mock) AI
AI_API_KEY=
AI_MODEL=

# Google sign-in (only for AUTH_MODE=google, Phase 7)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Email for password reset (optional)
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
