
# Copy this file to .env and fill in your own values.
# NEVER put real passwords or API keys in this example file.

# Required. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
FLASK_DEBUG=true

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lumora_db
DB_USER=
DB_PASSWORD=

# Login mode: demo (local accounts) or google (needs Google setup)
AUTH_MODE=demo

# Optional. Days a 'Remember me' login lasts
REMEMBER_ME_DAYS=7

# Optional. Password for the fictional demo accounts
DEMO_PASSWORD=

# AI mode: mock (local demo AI) or live (real AI API)
# Live mode requires both AI_API_KEY and AI_MODEL.
# Use mock until valid live API credentials are configured.
AI_MODE=mock
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Google sign-in (only for AUTH_MODE=google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Email for password reset (optional)
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
